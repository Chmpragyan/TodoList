TEAM_ID=

PRODUCT_NAME=TodoList
PRODUCT_BUNDLE_IDENTIFIER=com.example.todolist.TodoList$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

ENABLE_SWIFT_ABI_CHECKER=NO
SWIFT_EMIT_ABI_DIGEST=NO
OTHER_LDFLAGS = $(inherited) -lsqlite3 -framework SwiftUI -Xlinker -no_implicit_dylibs
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = NO
BUILD_LIBRARY_FOR_DISTRIBUTION = NO
LD_VERIFY_INTERFACE_LTO_SYMBOL_VISIBILITY = NO
SWIFT_USE_INTEGRATED_DRIVER = NO