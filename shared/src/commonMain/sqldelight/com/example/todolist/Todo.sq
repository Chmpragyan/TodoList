CREATE TABLE Todo(
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    description TEXT NOT NULL
);

-- Insert Note
insertTodo:
INSERT INTO Todo(title, description) VALUES (?,?);

-- Select
selectAllTodo:
SELECT * FROM Todo;

-- Update
updateTodo:
UPDATE Todo
SET title = :title, description = :description
WHERE id = :id;

-- Delete
deleteTodoById:
DELETE FROM Todo WHERE id = :id;

-- Delete All
deleteAllTodo:
DELETE FROM Todo;